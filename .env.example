# ===== 微信公众号 =====
# 公众号 AppID（微信公众平台 → 设置与开发 → 基本配置）
WECHAT_APP_ID=

# 公众号「消息推送」里自己填的 Token，必须与服务端代码一致
WECHAT_VERIFY_TOKEN=

# 安全模式必填：43 位 EncodingAESKey；明文模式留空
WECHAT_AES_KEY=

# ===== Dify 工作流 =====
# Dify 应用 → 访问 API → API 密钥
DIFY_API_KEY=

# 保活工作流密钥（可选）。作用：定时打一个轻量工作流，
# 避免 MCP 插件闲置约 15 秒被卸载导致下次调用多等 4.5 秒
DIFY_KEEPALIVE_KEY=

# 工作流端点
DIFY_WORKFLOW_URL=http://192.168.1.10/v1/workflows/run
DIFY_KEEPALIVE_URL=http://192.168.1.10/v1/workflows/run

# ===== MySQL =====
MYSQL_HOST=192.168.1.10
MYSQL_USER=root
MYSQL_PASSWORD=

# ===== 可选：微信回调服务监听 =====
# 微信要求 80 或 443
# PORT=80
